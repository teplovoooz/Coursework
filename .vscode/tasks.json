{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe сборка активного файла",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/std:c++17",
                "/I${workspaceFolder}\\include",
                "/Fe${workspaceFolder}\\build\\${fileBasenameNoExtension}.exe",
                "${workspaceFolder}\\src\\main.cpp",
                "${workspaceFolder}\\src\\matrix.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Компиляция main.cpp и matrix.cpp с подключением include"
        }
    ],
    "version": "2.0.0"
}